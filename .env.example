# Document model (src/lib/documents/generation/claude.ts, decision D-65).
# Copy to .env.local and fill in the key there; .env.local is git-ignored.

# Provider for the document model: openrouter or anthropic (unset: openrouter if its key is set, else anthropic).
MODEL_PROVIDER=openrouter
# OpenRouter API key, sent as a bearer token to https://openrouter.ai/api.
OPENROUTER_API_KEY=your-openrouter-key
# Model in OpenRouter's naming; default is the latest Opus.
OPENROUTER_MODEL=anthropic/claude-opus-5.5
# Anthropic API key, used when MODEL_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=your-anthropic-key
# Model in Anthropic's naming; default is the latest Opus.
# ANTHROPIC_MODEL=claude-opus-5-5
